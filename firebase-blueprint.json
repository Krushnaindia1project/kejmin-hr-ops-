        "location": { "type": "string", "minLength": 1, "maxLength": 60 },
        "designation": { "type": "string", "maxLength": 100 },
        "joinedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "maxLength": 10 },
