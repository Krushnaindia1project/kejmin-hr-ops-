      "title": "Task",
      "description": "Operational workflow task moving across sequential approval stages.",
      "type": "object",
      "properties": {
        "taskId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
