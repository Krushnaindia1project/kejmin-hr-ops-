        "active": { "type": "boolean" },
        "authUid": { "type": "string", "maxLength": 128 },
        "orgId": { "type": "string", "enum": ["kejmin"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["empId", "docId", "name", "role", "branch", "location", "designation", "joinedAt", "photoUrl", "active", "authUid", "orgId", "createdAt", "updatedAt"]
    },
    "UserPrivate": {
      "title": "UserPrivate",
