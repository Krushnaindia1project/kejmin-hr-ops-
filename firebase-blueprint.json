    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted administrator lookup document keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "role": { "type": "string", "enum": ["Developer", "Company Owner"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role", "createdAt"]
    },
    "DirectoryEntry": {
      "title": "DirectoryEntry",
      "description": "Non-PII organizational directory entry for an employee used in workflows, KPIs, and attendance.",
      "type": "object",
      "properties": {
        "empId": { "type": "string", "minLength": 3, "maxLength": 32, "pattern": "^[a-z0-9._]{3,20}$" },
        "docId": { "type": "string", "minLength": 3, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
